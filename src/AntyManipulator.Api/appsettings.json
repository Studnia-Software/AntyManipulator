    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Llm": {
    "Uri": "https://api.groq.com/openai/v1/chat/completions",
    "ApiKey": "",
    "Model": "openai/gpt-oss-120b",
    "ReasoningEffort": "low",
    "ResponseFormat": "JsonSchema",
    "TimeoutSeconds": 60,
    "MaxRateLimitRetries": 2,
    "MaxRetryDelaySeconds": 20
  },
  "Pipeline": {
    "MaxInputChars": 5000,
    "MaxMaterialChars": 6000,
    "MaxClaims": 3,
    "MaxPassagesPerClaim": 6,
    "MaxPassagesPerSource": 2,
    "PassageChars": 600,
    "SourceTimeoutSeconds": 12,
    "CheckTimeoutSeconds": 120
  },
  "Fetch": {
    "TimeoutSeconds": 10,
    "MaxBytes": 3000000,
    "MaxRedirects": 3,
    "UserAgent": "AntyManipulator/0.1",
    "Contact": "",
    "MaxConcurrentPerHost": 2,
    "MaxRetryWaitSeconds": 5
  },
